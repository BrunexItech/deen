# Copy to deploy/.env on the server. Generate every secret fresh.
POSTGRES_PASSWORD=
JWT_SECRET=
HASH_PEPPER=
DATA_KEY=
MPESA_CALLBACK_TOKEN=
APP_URL=https://deen.africa
API_PUBLIC_URL=https://deen.africa
CORS_ORIGINS=https://deen.africa
TRUSTED_PROXIES=2
STAFF_MFA_REQUIRED=true
