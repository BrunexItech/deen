SMS_PROVIDER=africastalking
OTP_ON_SCREEN=false
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
PAYMENTS_PROVIDER=daraja
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
