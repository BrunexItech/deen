# Copy to .env and adjust. Every value has a safe development default.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://deen:deen@localhost:5437/deen
# REDIS_URL=redis://localhost:6379/0        # shared rate limits across API replicas

# Secrets: generate fresh values for production
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=change-me-jwt
HASH_PEPPER=change-me-pepper
# DATA_KEY=<fernet key> (required in production)
MPESA_CALLBACK_TOKEN=change-me-callback

APP_URL=http://localhost:3020
API_PUBLIC_URL=http://localhost:8020
CORS_ORIGINS=http://localhost:3020
EMBEDDED_WORKER=true
STAFF_MFA_REQUIRED=false

# SMS (Africa's Talking)
SMS_PROVIDER=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Email (any SMTP relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DEEN <no-reply@deen.africa>

# M-Pesa Daraja (Lipa na M-Pesa Online)
PAYMENTS_PROVIDER=sandbox
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=

# Expo push notifications (optional access token for enhanced security)
EXPO_ACCESS_TOKEN=
